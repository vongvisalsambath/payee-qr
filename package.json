{
  "name": "payee-qr",
  "version": "0.1.0",
  "description": "Reads EMV payment QR codes (KHQR, PromptPay, DuitNow, QRIS, VietQR, PayNow/SGQR and others), checks them against the EMVCo specification, and says who the money really goes to.",
  "license": "Apache-2.0",
  "author": "Vong Visalsambath",
  "repository": { "type": "git", "url": "git+https://github.com/vongvisalsambath/payee-qr.git" },
  "keywords": ["emv", "qr", "emvco", "khqr", "bakong", "promptpay", "duitnow", "qris", "vietqr", "paynow", "sgqr", "payments"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:site": "node scripts/build-site.mjs",
    "dev": "node scripts/build-site.mjs --serve",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=.test --log-level=warning && node --test --test-timeout=120000 .test/*.test.js",
    "test:e2e": "node test/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "playwright": "1.63.0",
    "typescript": "5.7.3"
  }
}
